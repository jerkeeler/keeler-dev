---
import { formatDuration } from '../../utils';

export interface Props {
  startDate?: Date;
  endDate?: Date;
}
const { startDate, endDate } = Astro.props;
let startDateStr = '';
let endDateStr = '';
if (startDate) {
  startDateStr = startDate.toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
if (endDate) {
  endDateStr = endDate.toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const diffStr = startDate ? formatDuration(startDate, endDate ?? new Date()) : '';
---

<div class="pr-4">
  <div class="text-sm">
    <p class="block sm:inline-block">
      {startDateStr}
      {startDate && '—'}
      {endDate ? endDateStr : 'current'}
    </p>
    <p class="block sm:inline-block">
      {diffStr && `(${diffStr})`}
    </p>
  </div>
  <slot />
</div>
